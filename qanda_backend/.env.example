# Backend environment variables for Q&A Chat Backend (Django)

# Core Django settings
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=.kavia.ai,localhost,127.0.0.1,testserver
TIME_ZONE=UTC

# Database (defaults to SQLite if not set)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/app/qanda_backend/db.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# OpenAI configuration (backend-only secret)
# REQUIRED for /api/ask to work
OPENAI_API_KEY=your-openai-api-key
# Optional model override
OPENAI_MODEL=gpt-4o-mini

# Cross-Origin Resource Sharing and client connectivity
# These settings help the frontend connect to the backend safely.
# Note: Do not put secrets from backend into frontend env; only public info is shared.

# Public base URL of the backend for use by frontend builds or proxies.
# This MUST be publicly reachable from the browser (e.g., via a gateway), not an internal container address.
# Example: https://my-app.example.com (gateway) or http://localhost:8000 (local dev)
PUBLIC_BACKEND_BASE_URL=http://localhost:8000

# CORS allowed origins for browser requests (comma-separated).
# Typically include the frontend origin(s) here.
# Example during local dev: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# If you rely on proxies (ingress/gateway), these help build accurate docs URLs.
# Leave as defaults unless you need to customize.
# USE_X_FORWARDED_HOST=True
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
